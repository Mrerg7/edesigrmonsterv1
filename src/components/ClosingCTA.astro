<section class="border-t border-white/10 bg-zinc-900 py-16">
  <div class="max-w-xl mx-auto px-6 text-center">
    <h2 class="font-display text-4xl tracking-tighter mb-4">Ready to own the future of electronic design?</h2>
    <p class="text-zinc-400 mb-8">This domain will not be available long. Secure it before your competitors do.</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <button
        type="button"
        data-offer-open="buy"
        data-track="closing-buy"
        class="inline-flex items-center justify-center gap-x-3 px-10 min-h-[56px] rounded-3xl bg-white text-zinc-950 font-semibold text-lg hover:bg-zinc-100 active:scale-[0.985] transition-all shadow-xl"
      >
        Start the conversation
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </button>
      <a
        href="/blog/domain-valuation-guide/"
        data-track="closing-valuation"
        class="inline-flex items-center justify-center px-8 min-h-[56px] rounded-3xl border border-white/20 hover:bg-white/5 transition-all"
      >
        Why $95,000?
      </a>
    </div>

    <div class="mt-6 text-xs text-zinc-500">Direct from owner • Confidential inquiries welcome • Escrow protected</div>
  </div>
</section>
