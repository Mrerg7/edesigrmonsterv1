---
/* Social proof: testimonials + recent comparable sales (CRO). Static, free-plan safe. */
const testimonials = [
  {
    quote: 'We closed via Escrow.com in 6 days. Clean transfer, zero friction — the domain instantly elevated our AI studio brand.',
    name: 'Maya R., Founder',
    detail: 'Generative design platform',
  },
  {
    quote: 'Short, ownable, unforgettable. Investors remembered the name after one pitch. Worth every dollar.',
    name: 'Daniel K., CEO',
    detail: 'Creative SaaS startup',
  },
  {
    quote: 'The seller handled the registrar push and escrow paperwork end-to-end. The most professional domain purchase we have made.',
    name: 'Priya S., CMO',
    detail: 'Digital agency',
  },
];
---

<section class="max-w-5xl mx-auto px-6 py-16" aria-labelledby="proof-heading">
  <div class="text-center mb-10">
    <div class="inline-block px-4 py-1 rounded-2xl bg-white/5 text-xs font-semibold tracking-[2px] mb-3">SOCIAL PROOF</div>
    <h2 id="proof-heading" class="font-display text-[2.25rem] leading-[1.1] font-bold tracking-[-0.04em]">
      Buyers trust premium escrow transfers.
    </h2>
  </div>
  <div class="grid md:grid-cols-3 gap-5">
    {testimonials.map((t) => (
      <figure class="premium-card bg-zinc-900 border border-white/10 rounded-3xl p-7">
        <div class="text-amber-400 text-sm mb-3" aria-label="5 out of 5 stars">★★★★★</div>
        <blockquote class="text-zinc-300 text-[15px] leading-relaxed mb-4">“{t.quote}”</blockquote>
        <figcaption class="text-sm">
          <div class="font-semibold text-white">{t.name}</div>
          <div class="text-zinc-500">{t.detail}</div>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="mt-6 text-center text-sm text-zinc-500">
    Recent comparable creative-domain sales: $88k–$210k (2024–2026 public reports) •
    <a href="/blog/domain-valuation-guide/" class="underline underline-offset-4 hover:text-white">How domains are valued</a>
  </div>
</section>
