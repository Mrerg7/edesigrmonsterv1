---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Domain Escrow Transfer Checklist: Close in 3–10 Days | eDesigr.monster"
  description="Escrow.com vs Dan.com step-by-step: fund escrow, push domain, confirm transfer, release funds. Close eDesigr.monster safely in 3–10 days."
  canonicalPath="/blog/domain-escrow-transfer-checklist/"
>
  <Nav />
  <main id="main" class="pt-28 pb-20 max-w-3xl mx-auto px-6">
    <p class="text-xs uppercase tracking-[3px] text-cyan-400 font-extrabold mb-4">Escrow • 5 min read</p>
    <h1 class="font-display text-4xl tracking-tight mb-6">Domain escrow transfer checklist: close in 3–10 days.</h1>
    <article class="space-y-5 text-zinc-300 leading-relaxed text-[17px]">
      <ol class="list-decimal pl-6 space-y-3">
        <li><strong class="text-white">Agree terms in writing</strong> — price ($95,000 USD), escrow provider (Escrow.com or Dan.com), timeline.</li>
        <li><strong class="text-white">Buyer funds escrow</strong> — wire/ACH into licensed escrow; seller is notified, never paid directly.</li>
        <li><strong class="text-white">Seller pushes domain</strong> — registrar transfer / auth code + unlock; full guidance provided.</li>
        <li><strong class="text-white">Buyer confirms control</strong> — WHOIS + DNS check in your registrar account.</li>
        <li><strong class="text-white">Escrow releases funds</strong> — only after your confirmation. Discreet private closings available.</li>
      </ol>
      <p class="text-zinc-400 text-[15px]">Red flags to avoid: sellers asking for direct wire, rushed off-escrow discounts, or refusing registrar verification.</p>
      <div class="bg-zinc-900 border border-white/10 rounded-3xl p-7 mt-8">
        <p class="font-semibold text-white mb-2">Start a protected acquisition.</p>
        <p class="text-sm text-zinc-400 mb-4">Every eDesigr.monster inquiry closes through licensed escrow with transfer support.</p>
        <a href="/#acquire" data-track="blog-escrow-cta" class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-2xl bg-white text-zinc-950 font-semibold">Begin acquisition</a>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
