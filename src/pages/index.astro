---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import WhySection from '../components/WhySection.astro';
import AiSection from '../components/AiSection.astro';
import ForSection from '../components/ForSection.astro';
import OpportunitySection from '../components/OpportunitySection.astro';
import AcquisitionSection from '../components/AcquisitionSection.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqSection from '../components/FaqSection.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Footer from '../components/Footer.astro';
import OfferModal from '../components/OfferModal.astro';
import ConversionOverlays from '../components/ConversionOverlays.astro';
---

<BaseLayout>
  <Nav />
  <main id="main">
    <Hero />
    <TrustBar />
    <WhySection />
    <AiSection />
    <ForSection />
    <OpportunitySection />
    <AcquisitionSection />
    <Testimonials />
    <FaqSection />
    <ClosingCTA />
    <Footer />
  </main>
  <OfferModal />
  <ConversionOverlays />
</BaseLayout>
